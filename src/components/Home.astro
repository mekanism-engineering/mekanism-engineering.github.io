---
import { getCollection } from 'astro:content';
import source from '../data/source.json';
import families from '../data/sidebar.json';
import { tr } from '../lib/i18n.js';
import { NEWS, UPDATE } from '../lib/features.mjs';
import { Badge } from '@astrojs/starlight/components';
import Survey from './Survey.astro';
const lng = Astro.locals.starlightRoute?.lang === 'fr' ? 'fr' : 'en';
const t = (en: string, vars?: Record<string, unknown>) => tr(lng, en, vars);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// the French pages are under fr/, the English ones at the root
const pre = lng === 'fr' ? 'fr/' : '';
const docs = (await getCollection('docs')).filter(d => (lng === 'fr') === d.id.startsWith('fr/'));
const FAMILIES = families.map((f: any) => (lng === 'fr' && f.translations?.fr) || f.label);
const machines = docs
  .filter(d => d.data.machine && !(d.data.machine.structure && d.data.machine.id !== 'ore_refinery_controller') && d.data.machine.id !== 'forge_laser_boost')
  .map(d => ({ d, fam: d.data.machine!.family ?? '', order: d.data.sidebar?.order ?? 9 }))
  .sort((a, b) => FAMILIES.indexOf(a.fam) - FAMILIES.indexOf(b.fam) || a.order - b.order);
const pic = (m: any) => m.id === 'ore_refinery_controller' ? '_refinery' : (m.model ?? m.id);
const guides = docs.filter(d => d.id.startsWith(pre + 'guides/')).sort((a, b) => (a.data.sidebar?.order ?? 9) - (b.data.sidebar?.order ?? 9));
const byId = (id: string) => docs.find(d => d.id === id || d.id === pre + id);
const tiles = ([['Overview', 'overview'], ['Basics', 'getting-started'], ...guides.map(g => ['Guide', g.id]), ['Reference', 'crafting'],
  ['Reference', 'in-game-texts'], ['Reference', 'configuration'], ['Help', 'faq']] as [string, string][])
  .map(([k, id]) => [k, byId(id)] as const).filter((t): t is readonly [string, NonNullable<ReturnType<typeof byId>>] => !!t[1]);
// the version's news (src/lib/features.mjs): a card or a link falls back to the English page while the French one is missing
const all = await getCollection('docs');
const page = (id: string) => all.find(d => d.id === pre + id) ?? all.find(d => d.id === id);
const cards = NEWS.cards.map(c => ({ ...c, ...c[lng], doc: page(c.page), moreDoc: c.more ? page(c.more) : undefined })).filter(c => c.doc);
const also = NEWS.alsoItems.map(a => a[lng]);
// the 1.3 changelog when it exists in this language, otherwise the release notes index
const changelog = all.some(d => d.id === pre + NEWS.changelog) ? NEWS.changelog : 'changelog';
const news = NEWS[lng];
// the current point release's strip (src/lib/features.mjs): its notes page in this language, otherwise the English one
const updateNotes = all.some(d => d.id === pre + UPDATE.changelog) ? pre + UPDATE.changelog : all.some(d => d.id === UPDATE.changelog) ? UPDATE.changelog : null;
const update = UPDATE[lng], updateItems = UPDATE.items.map(i => i[lng]);
const short = (s = '') => (s.length > 110 ? s.slice(0, s.lastIndexOf(' ', 106)) + '…' : s);
---

<div class="me-home not-content">
  <section class="me-hero">
    <div class="me-hero-text">
      <div class="me-eyebrow">{t('Mekanism addon')} · <span style="text-transform:none">v{source.modVersion}</span> · <span style="white-space:nowrap">Minecraft {source.builds.map(b => b.minecraft).join(' & ')}</span></div>
      <h1 set:html={t('Engineering,<br />at quantum scale.')} />
      <p>{t('Remote mining, whole-chain ore refining, quantum networks and precise logistics. The complete wiki of Mekanism: Engineering.')}</p>
    </div>
    <div class="me-cta">
      <a class="me-btn primary" href={`${base}/${pre}overview/`}>{t('Start here →')}</a>
      <a class="me-btn" href="https://www.curseforge.com/minecraft/mc-mods/mekanism-engineering">CurseForge ↗</a>
    </div>
    <div data-me3d data-kind="refinery" data-mode="assembled" data-tags="hero">
      <!-- the still picture only without JavaScript: with it, the 3D view and its intro are the first thing shown -->
      <div class="me-stage"><noscript><img src={`${base}/icons/mekanismengineering/_refinery.png`} alt={t('The Quantum Ore Refinery')} style="width:100%;height:100%;object-fit:contain" /></noscript></div>
    </div>
  </section>

  <Survey />

  {updateNotes && (
    <section class="me-news me-update" aria-labelledby="me-update-title">
      <div class="me-news-head">
        <div class="me-eyebrow">{update.eyebrow}</div>
        <h2 id="me-update-title">{update.title}</h2>
        <p class="me-update-lead">{update.lead}</p>
      </div>
      <div class="me-news-also" role="group" aria-label={update.eyebrow}>
        {updateItems.map(a => (
          <div>
            <div class="me-eyebrow"><span class="me-news-badge">{a.badge}</span> {a.family}</div>
            <h4>{a.title}</h4>
            <p>{a.say}</p>
          </div>
        ))}
      </div>
      <a class="me-news-all" href={`${base}/${updateNotes}/`}>{update.all}</a>
    </section>
  )}

  {cards.length > 0 && (
    <section class="me-news" aria-labelledby="me-news-title">
      <div class="me-news-head">
        <div class="me-eyebrow">{news.eyebrow}</div>
        <h2 id="me-news-title">{news.title}</h2>
      </div>
      <div class="me-news-grid">
        {cards.map(c => (
          <article class="me-news-card">
            <a class="me-news-visual me-news-anim" href={`${base}/${c.doc.id}/`} tabindex="-1">
              <picture><source media="(prefers-reduced-motion: reduce)" srcset={`${base}/${c.screens}-${lng}-1.png`} />
                <img src={`${base}/${c.screens}-${lng}.gif`} alt={c.alt} loading="lazy" width={c.width} height={c.height} /></picture>
            </a>
            <div class="me-news-body">
              <div class="me-eyebrow"><span class="me-news-badge">{c.badge}</span> {c.family}</div>
              <h3>{c.title}</h3>
              <p class="me-news-lead">{c.lead}</p>
              <ul class="me-news-points">
                {c.points.map(([title, say], i) => (
                  <li><span class="me-feature-num">{i + 1}</span><div><b>{title}</b><p>{say}</p></div></li>
                ))}
              </ul>
              <div class="me-news-btns">
                <a class="me-btn primary" href={`${base}/${c.doc.id}/`}>{c.open} →</a>
                {c.moreDoc && <a class="me-btn primary" href={`${base}/${c.moreDoc.id}/`}>{c.openMore} →</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="me-news-also" role="group" aria-label={news.also}>
        {also.map(a => (
          <div>
            <div class="me-eyebrow"><span class="me-news-badge">{a.badge}</span> {a.family}</div>
            <h4>{a.title}</h4>
            <p>{a.say}</p>
          </div>
        ))}
      </div>
      <a class="me-news-all" href={`${base}/${pre}${changelog}/`}>{news.all}</a>
    </section>
  )}

  <h2>{t('The machines')}</h2>
  <p class="me-sub">{t('{n} machines and tools. Blue: Quantum. Copper: Mekanism style.', { n: machines.length })}</p>
  <div class="me-rail-wrap">
  <button type="button" class="me-rail-btn prev" aria-label={t('Previous machines')}>←</button>
  <button type="button" class="me-rail-btn next" aria-label={t('Next machines')}>→</button>
  <div class="me-rail">
    {machines.map(({ d, fam }) => (
      <a class:list={['me-card', { g: !d.data.machine!.quantum }]} href={`${base}/${d.id}/`}>
        {/* the same purple label as in the sidebar; it says "New" in place of the " · new" the eyebrow had */}
        <div class="me-eyebrow"><span>{fam}</span>{d.data.machine!.isNew && <Badge text={t('New')} variant="tip" size="small" />}</div>
        <img class:list={{ flat: !d.data.machine!.model && !d.data.machine!.structure && !d.data.machine!.photo }} src={`${base}/icons/mekanismengineering/${pic(d.data.machine)}.png`} alt="" loading="lazy" />
        <h3>{d.data.title}</h3>
        <p>{short(d.data.description)}</p>
      </a>
    ))}
  </div>
  </div>

  <h2>{t('Start here')}</h2>
  <p class="me-sub">{t('New to the mod? These pages take you from your first machine to a working setup.')}</p>
  <div class="me-tiles">
    {tiles.map(([kind, d]) => (
      <a class="me-tile" href={`${base}/${d.id}/`}><div class="me-eyebrow">{t(kind)}</div><h3>{d.data.title}</h3><p>{short(d.data.description)}</p></a>
    ))}
  </div>
</div>

<script>
  for (const wrap of document.querySelectorAll('.me-rail-wrap')) {
    const rail = wrap.querySelector('.me-rail') as HTMLElement;
    wrap.querySelector('.prev')?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * 0.8, behavior: 'smooth' }));
    wrap.querySelector('.next')?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * 0.8, behavior: 'smooth' }));
  }
</script>
